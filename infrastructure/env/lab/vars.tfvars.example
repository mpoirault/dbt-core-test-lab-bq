# Copy to vars.tfvars in this folder and fill in the values. The *.tfvars rule gitignores it.
# Nothing in here is secret. GCP auth comes from application default credentials.

gcp_project = "<your-gcp-project-id>"
gcp_region  = "europe-west4"
# The same bucket as in backend-config.tfvars. Backend blocks cannot read variables.
state_bucket = "<your-tfstate-bucket>"

gh_repo_name = "dbt-core-test-lab-bq"

# Optional, defaults in variables.tf.
# ar_repository      = "dbt-core-test-lab-bq"
# cloud_run_job_name = "dbt-core-prod-build"
