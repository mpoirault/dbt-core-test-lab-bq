# Terraform
.terraform/
# The validate hook runs per directory and drops lockfiles inside modules.
# Only the root lockfile is real.
infrastructure/modules/**/.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
# Backend config holds only the state bucket name, keep it tracked.
!infrastructure/env/*/backend-config.tfvars
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# dbt. profiles.yml is committed, its three oauth targets hold no secrets.
target/
dbt_packages/
logs/
.user.yml

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env

# Tool caches from the pre-commit hooks
.ruff_cache/
.rumdl_cache/

# mise per-developer overrides, mise.toml is committed
mise.local.toml

# .claude/ is committed. A user-level git ignore can exclude it, so un-ignore it here.
!.claude/
!.claude/**
.claude/settings.local.json

# Editor and OS. .vscode/settings.json is committed.
.DS_Store
.idea/
.vscode/*
!.vscode/settings.json

# Secrets. Explicit names, *.json stays unignored.
gcp-sa-*.json
credentials.json
service-account*.json
