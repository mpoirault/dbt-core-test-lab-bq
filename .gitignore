# Terraform
.terraform/
# the validate hook runs per directory and drops lockfiles inside modules,
# only the root lockfile is the real one
infrastructure/modules/**/.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
# backend config is not a secret (just the state bucket name), keep it tracked
!infrastructure/env/*/backend-config.tfvars
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# dbt. profiles.yml IS committed: three oauth targets, no secrets in it
target/
dbt_packages/
logs/
.user.yml

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env

# Tool caches (created locally by pre-commit hooks)
.ruff_cache/
.rumdl_cache/

# mise per-developer overrides (mise.toml IS committed)
mise.local.toml

# Claude Code repo config IS committed (plugin, settings).
# A user-level git ignore may exclude .claude/; un-ignore it here.
!.claude/
!.claude/**
.claude/settings.local.json

# Editor / OS — .vscode/settings.json IS committed (shared editor config)
.DS_Store
.idea/
.vscode/*
!.vscode/settings.json

# Secrets (be explicit; do not blanket-ignore *.json)
gcp-sa-*.json
credentials.json
service-account*.json
